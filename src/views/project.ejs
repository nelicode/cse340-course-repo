<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>
            <%= project.title %>
        </h2>

        <p><strong>Description:</strong>
            <%= project.description %>
        </p>
        <p><strong>Date:</strong>
            <%= new Date(project.date).toLocaleDateString() %>
        </p>
        <p><strong>Location:</strong>
            <%= project.location %>
        </p>

        <p><strong>Organization:</strong>
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>
        
        <p><strong>Categories:</strong>
            <% if (categories && categories.length> 0) { %>
                <% categories.forEach(category=> { %>
                    <a href="/category/<%= category.category_id %>"
                        style="background: #e9ecef; padding: 4px 8px; border-radius: 4px; margin-right: 5px; text-decoration: none; color: #333; display: inline-block; margin-bottom: 5px;">
                        <%= category.category_name %>
                    </a>
                    <% }) %>
                        <% } else { %>
                            <span>None</span>
                            <% } %>
        </p>

    </main>
    <%- include('partials/footer') %>